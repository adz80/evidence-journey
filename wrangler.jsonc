{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evidence-journey",
  "main": "src/index.js",
  // Set this to the day you deploy.
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],

  // Never expose this Worker on workers.dev or preview URLs. Gateway invokes the
  // GatewayMiddleware entrypoint directly; the evidence UI/API is only reachable on
  // the custom domain below, which must sit behind a Cloudflare Access application.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "evidence.chewbacca.dev", "custom_domain": true }],

  // Web front end (same UI as the gadget). run_worker_first makes every asset request
  // pass the Access JWT check in src/api.js before anything is served.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "insider-evidence-poc" }],

  "queues": {
    "producers": [{ "binding": "CAPTURE_QUEUE", "queue": "evidence-capture" }],
    "consumers": [
      {
        "queue": "evidence-capture",
        "max_batch_size": 50,
        "max_batch_timeout": 2,
        "max_retries": 10,
        "dead_letter_queue": "evidence-capture-dlq"
      }
    ]
  },

  "durable_objects": { "bindings": [{ "name": "LEDGER", "class_name": "CaseLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CaseLedger"] }],

  "browser": { "binding": "BROWSER" },

  "observability": { "enabled": true },

  // Australia. The investigator UI/API runs next to AWS Sydney (ap-southeast-2).
  // Capture runs wherever the subject's traffic enters Cloudflare (Gateway invokes the
  // middleware at their nearest data centre), so it is in Australia when they are.
  // The R2 bucket was created with location hint "oc" (Oceania) and case ledgers are
  // created with LEDGER_LOCATION_HINT. Check with GET /api/placement.
  "placement": { "region": "aws:ap-southeast-2" },

  "vars": {
    // Your Zero Trust team domain and the AUD tag of the Access application that
    // protects EVIDENCE_HOST. The API refuses every request until both are set.
    "ACCESS_TEAM_DOMAIN": "https://hometesting8080.cloudflareaccess.com",
    "ACCESS_AUD": "213080684c76bf274a8616eb3754456b3d59ec555e1555ff8e191de4a7659c16",

    // Hostname of the evidence UI/API. Traffic to it is never captured.
    "EVIDENCE_HOST": "evidence.chewbacca.dev",

    // Data location (see "placement" above). Informational except LEDGER_LOCATION_HINT.
    "PLACEMENT_REGION": "aws:ap-southeast-2",
    // Free text shown by GET /api/placement; change it to confirm a deploy went out.
    "RELEASE": "2026-11-19 console redesign",
    "LEDGER_LOCATION_HINT": "oc",
    "EVIDENCE_BUCKET_NAME": "insider-evidence-poc (location OC)",

    // Per-response / per-request-body capture cap in bytes (2 MB).
    "MAX_CAPTURE_BYTES": "2097152",

    // Idle gap that splits browsing sessions in the journey view.
    "SESSION_IDLE_MINUTES": "30",

    // Behaviour detectors (see src/insights.js). Signals are leads to review, not findings.
    // Working hours in WORK_TZ; anything outside (or on days outside WORK_DAYS, Mon=1) is "after hours".
    "WORK_HOURS": "08:00-18:00",
    "WORK_DAYS": "1-5",
    "WORK_TZ": "Australia/Sydney",
    // The organisation's own domains: categorised "Corporate (work)" and never treated as personal.
    "CORP_DOMAINS": ["chewbacca.dev"],
    // Optional: Gateway policy ID -> Cloudflare content category name, for per-category Forward rules.
    "CATEGORY_POLICIES": {},
    // Names for the device posture check UUIDs Gateway reports as passed (context.devicePosture()).
    "POSTURE_CHECKS": { "c1da6900-b91f-42c9-acbc-4db03fef54f6": "Windows_11 and Crowdstrike" },
    // Watch lists for search terms. Agree these with HR/Legal before any real case.
    // Leave a list out to use the built-in defaults.
    "WATCH_TERMS": {},

    // Cases. Capture only happens for the subject's identity email, and only
    // between start and end (ISO 8601, UTC). PoC: the subject must be you or a
    // test account. Changes are made by editing this list and redeploying.
    "CASES": [
      {
        "id": "poc-001",
        "title": "PoC self-test (test account)",
        "subject": "headoffice@chewbacca.dev",
        "start": "2026-11-18T00:00:00Z",
        "end": "2026-12-18T00:00:00Z",
        "captureSent": true,
        // PoC only: lets an investigator clear all of this case's data from the UI.
        // Never set this on a real case.
        "allowReset": true,
        // Ledger created in Oceania. "poc-001" was the first ledger (created in the US);
        // the PoC reset wipes it.
        "ledgerName": "poc-001-au",
        "retiredLedgers": ["poc-001"]
      }
    ]
  }
}
